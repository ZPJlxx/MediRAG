# ============================================================
# MediRAG 统一配置
# 开发模式默认零外部依赖：SQLite + 无 RabbitMQ（HTTP 回传化验结果）
# 生产模式：docker-compose 启动 MySQL/RabbitMQ 后改用对应配置
# ============================================================

# ---- 运行环境 dev | prod ----
APP_ENV=dev

# ---- 数据库（dev 默认 SQLite；prod 用 MySQL，见 docker-compose）----
# DATABASE_URL=mysql+pymysql://root:medirag123@localhost:3306/medirag
DATABASE_URL=sqlite:///./database/medirag.db

# ---- JWT 鉴权 ----
JWT_SECRET=change-me-in-production-9f8e7d6c5b4a
JWT_EXPIRE_MINUTES=720

# ---- LLM 网关（OpenAI 兼容协议）----
# 三选一：显式 OPENAI 兼容配置 > DASHSCOPE_API_KEY(qwen) > DEEPSEEK_API_KEY
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
DASHSCOPE_API_KEY=sk-ws-H.YourDashScopeKeyHere
DEEPSEEK_API_KEY=

# ---- 检索侧 Embedding（provider: dashscope | openai）----
RETRIEVAL_EMBEDDING_PROVIDER=dashscope
RETRIEVAL_EMBEDDING_MODEL=text-embedding-v3
RETRIEVAL_EMBEDDING_BASE_URL=
RETRIEVAL_EMBEDDING_API_KEY=

# ---- 检索侧 Rerank（provider: dashscope | disabled）----
RETRIEVAL_RERANK_PROVIDER=dashscope
RETRIEVAL_RERANK_MODEL=gte-rerank-v2
RETRIEVAL_RERANK_API_KEY=

# ---- 医疗 Agent 是否启用 RAG grounding（A/B 评估时可关闭）----
MEDICAL_RAG_ENABLED=true
# 每个 Agent 单次检索注入的证据条数上限
RAG_TOP_K=5

# ---- 文档切分参数 ----
CHUNK_SIZE=500
CHUNK_OVERLAP=200

# ---- Embedding 并发（建索引起建 API 吞吐；超限自动降级重试，不建议超过 8）----
EMBED_CONCURRENCY=4

# ---- RabbitMQ（dev 关闭；开启后化验结果走 MQ 异步回传，HTTP 接口始终可用）----
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---- 向量库后端（sqlite | qdrant；milvus 插槽已预留待实现）----
# sqlite: 零依赖默认值（SQLite + numpy 余弦，万级 chunk 毫秒级）
# qdrant: 成熟开源向量库；QDRANT_URL 留空用 local 嵌入式（无服务进程），
#         填 http://localhost:6333 切 Docker 服务端（docker-compose 已带）
VECTOR_BACKEND=sqlite
QDRANT_URL=
